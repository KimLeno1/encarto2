# Encarto Environment Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/encarto_db?schema=public

# Session & Security
# Generate a unique random value of at least 32 characters for production.
SESSION_SECRET=replace-with-random-32-plus-character-secret
# Comma-separated exact origins; add your deployed frontend origin for production.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Initial Admin Provisioning (run 'npm run seed:admin' explicitly)
# Use unique credentials. Production rejects the example values below.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-unique-password-at-least-16-chars

# Optional server-side Gemini key. Never inject this value into Vite client code.
GEMINI_API_KEY=
