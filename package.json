{
  "name": "encarto-gaming-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "seed:admin": "tsx scripts/seedAdmin.ts"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.561.0",
    "morgan": "^1.12.1",
    "phaser": "^4.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.encarto.desktop",
    "productName": "Encarto",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "artifactName": "Encarto-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Game",
      "maintainer": "Encarto"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libasound2"
      ]
    }
  }
}
